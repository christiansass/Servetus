[Unit]
Description=Servetus Talk Listener (NC Talk polling bot)
Documentation=file:///mnt/Cloud/Nextcloud/Obsidian/Servetus/10-System/talk-listener.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/Cloud/Nextcloud/Obsidian/Servetus
ExecStart=/usr/bin/python3 10-System/talk-listener.py
Restart=on-failure
RestartSec=15
StandardOutput=append:/mnt/Cloud/Nextcloud/Obsidian/Servetus/10-System/talk-listener.log
StandardError=append:/mnt/Cloud/Nextcloud/Obsidian/Servetus/10-System/talk-listener.log
Environment=HOME=/home/sastian

[Install]
WantedBy=default.target
