[Unit]
Description=Servetus Transcription Queue (Whisper GPU daemon)
Documentation=file:///mnt/Cloud/Nextcloud/Obsidian/Servetus/10-System/transcription-queue.py
After=network-online.target nextcloud-client.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/Cloud/Nextcloud/Obsidian/Servetus
ExecStart=/usr/bin/python3 10-System/transcription-queue.py
Restart=on-failure
RestartSec=30
StandardOutput=append:/mnt/Cloud/Nextcloud/Obsidian/Servetus/10-System/transcription-queue.log
StandardError=append:/mnt/Cloud/Nextcloud/Obsidian/Servetus/10-System/transcription-queue.log

# GPU environment
Environment="CUDA_VISIBLE_DEVICES=0"
Environment="HOME=/home/sastian"

[Install]
WantedBy=default.target
