{
  "nodes": [
    {
      "id": "truth-hierarchy",
      "type": "text",
      "x": 0,
      "y": -800,
      "width": 480,
      "height": 320,
      "color": "1",
      "text": "# Hierarchy of Truth\n\n**God / Reality / Truth**\n↓\n**Witnesses** — artifacts captured from reality\n↓\n**Structured Memory** — human-readable, editable, verifiable\n↓\n**AI Processing** — interpretation, assistance, synthesis\n↓\n**Human Review** — the user corrects, confirms, or rejects\n↓\n**Reality Check** — go back to the witness"
    },
    {
      "id": "vault-header",
      "type": "text",
      "x": -800,
      "y": -300,
      "width": 300,
      "height": 80,
      "color": "6",
      "text": "# VAULT FILESYSTEM\n**Altitude Model: Low = Ground Truth, High = Big Picture**"
    },
    {
      "id": "00-system",
      "type": "text",
      "x": -800,
      "y": -180,
      "width": 300,
      "height": 100,
      "color": "4",
      "text": "## 00-system/\n**System layer**\n- CLI (`servetus_cli.py`)\n- Voice pipeline code\n- Nextcloud adapters\n- VERSION"
    },
    {
