# ======================
# Altitude folders: track specs, ignore content
# ======================
# Default-deny for ALL root directories. Any folder not explicitly un-ignored below
# is blocked from git entirely — numbered, named, or otherwise. This prevents any
# new directory (created by AI drift, contributor error, or accident) from exposing
# personal content. To add a new tracked folder, explicitly add !/FolderName/ below.
/*/

# Explicitly permitted root directories (everything else blocked by /*/ above)
!Toolkit/
!10-System/
!docs/
!templates/
!assets/
!assets/images/
!00-Artifacts/
!01-Records/
!02-Memories/
!03-Events/
!04-Projects/
!05-Arcs/
!06-Radar/
!07-StoryMap/
!08-People/
!08-Witnesses/
!09-Shared/

# Grok project skills (versioned slash commands — e.g. /clean-exit)
!.grok/
!.grok/skills/
!.grok/skills/**

# Artifacts (original evidence locker — copied originals, date-sorted)
00-Artifacts/**
!00-Artifacts/.gitkeep
!00-Artifacts/_artifact-spec.md
!00-Artifacts/_artifact-template.md

# Legacy name — kept until all references are migrated
00-inbox/**

# Records (Markdown field records of artifacts)
01-Records/**
!01-Records/.gitkeep
!01-Records/_record-spec.md
!01-Records/_record-template.md

# Memories (atomized thoughts)
02-Memories/**
!02-Memories/.gitkeep
!02-Memories/_memory-spec.md
!02-Memories/_memory-template.md

