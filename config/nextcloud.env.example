# Nextcloud credentials — copy to nextcloud.env and fill in your values
# nextcloud.env is gitignored — this example file is the only thing committed

NEXTCLOUD_URL=https://your.nextcloud.server
NEXTCLOUD_USER=your-username
NEXTCLOUD_APP_PASSWORD=your-app-password

# Generate an app password at:
# Settings → Security → Devices & sessions → App passwords
# Name it "Servetus" so you can identify and revoke it later

# Path to this vault on the host machine (used by docker-compose.yml)
# Default: /mnt/Cloud/Nextcloud/Obsidian/Servetus
VAULT_PATH=/mnt/Cloud/Nextcloud/Obsidian/Servetus

# Anthropic API key (for Claude Sonnet fallback when Ollama is insufficient)
API_KEY=

# Webhook secret for Talk Bot API (Servetus XO)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Register bot with: php occ talk:bot:install "Servetus" <WEBHOOK_SECRET> \
#   https://your-host:8082/webhook "Servetus XO" --feature=webhook --feature=response
WEBHOOK_SECRET=

# Optional: SMTP for Talk approval protocol token delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
